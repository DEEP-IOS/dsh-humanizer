{
  "name": "dsh-humanizer",
  "version": "0.4.0-alpha.1",
  "description": "中文写作与润色工作台：本地证据记忆图谱、任务恢复、按需完整理论与内容忠实守卫。不评分、不检测、不设文风配额。",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./invariant": "./invariant.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "invariant.js",
    "cordis.patch.yml",
    "lib/",
    "scripts/",
    "references/",
    "docs/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    },
    "compatibility": {
      "dsh": "0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1",
      "profiles": [
        "web"
      ],
      "dshReleases": {
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "unknown"
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "pnpm test",
    "guard": "node scripts/guard-humanizer.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.2-0 || ^0.1.3-0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.2-0 || ^0.1.3-0"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEEP-IOS/dsh-humanizer.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "humanizer",
    "chinese-writing",
    "novel",
    "去AI味"
  ],
  "license": "MIT"
}
